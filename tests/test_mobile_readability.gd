extends SceneTree
var failures := 0
var app
func _init(): call_deferred("run")
func check(ok: bool, why: String):
	if not ok: failures += 1; printerr("FAIL: " + why)
func settle():
	for i in range(10): await process_frame
func capture(label: String):
	if DisplayServer.get_name() != "headless" and "--capture" in OS.get_cmdline_user_args():
		await RenderingServer.frame_post_draw
		root.get_texture().get_image().save_png("res://evidence/mobile-readable-"+label+".png")
func run():
	app = load("res://scenes/main.tscn").instantiate(); app.persistence = false; root.add_child(app)
	await settle()
	app.display_settings.mobile = true; app.display_settings.ui_scale = 1.25; app.display_settings.free_aspect = true
	app.apply_display_settings(false)
	app.handle_command("new", {"mode":"challenge", "origin":"strong", "seed":22})
	await settle()
	var saved: Dictionary = app.session.snapshot()
	for resolution in [Vector2i(1260,540), Vector2i(1280,720), Vector2i(1680,720)]:
		root.size = resolution; await settle()
		app.handle_ui("local_panel","settings"); await settle()
		var surface = app.find_child("ModalSurface",true,false)
		var surface_ratio: float = surface.size.x/maxf(surface.size.y,1.0)
		check(absf(surface_ratio-16.0/9.0)<0.02, "phone settings surface keeps the 16:9 frame")
		check(surface.size.y >= app.size.y*.95, "phone settings still fill the available height")
		check(absf(surface.get_global_rect().get_center().x-app.size.x*.5)<=2.0, "phone settings surface stays centred")
		var back = app.find_child("SettingsBack",true,false)
		check(back != null, "phone settings have explicit back navigation")
		for tab in ["TabDisplay","TabGame"]:
			app.find_child(tab,true,false).pressed.emit(); await settle()
			var scroll = app.find_child("MobileSettingsScroll",true,false)
			check(scroll.size.y >= 180,"phone settings leave useful reading height")
			for node in surface.find_children("*","Control",true,false):
				if not node.is_visible_in_tree(): continue
				if node is Label: check(node.get_theme_font_size("font_size")>=18,"phone setting copy is readable: "+node.text.left(20))
				if node is BaseButton:
					check(node.size.y>=56,"phone setting touch height: "+str(node.name))
					check(node.get_theme_font_size("font_size")>=20,"phone setting button font: "+str(node.name))
			await capture("%dx%d-%s" % [resolution.x,resolution.y,tab])
		if resolution==Vector2i(1260,540):
			app.find_child("TabGame",true,false).pressed.emit(); await settle()
			app.find_child("MobileSettingsScroll",true,false).scroll_vertical=60; await settle()
			app.find_child("TabDisplay",true,false).pressed.emit(); await settle()
			app.find_child("TabGame",true,false).pressed.emit(); await settle()
			check(app.find_child("MobileSettingsScroll",true,false).scroll_vertical==60,"settings remember per-tab reading position")
			app.apply_display_settings(false); await settle()
			check(app.find_child("MobileSettingsScroll",true,false).scroll_vertical==60,"settings preserve position when UI rebuilds")
			back=app.find_child("SettingsBack",true,false)
		if back: back.pressed.emit()
		else: app.local_panel=""; app.render()
		await settle()
		check(app.session.snapshot()==saved,"settings navigation preserves complete session state")
		for name in ["GameHelpEntry","HomeEntry"]:
			var entry = app.find_child(name,true,false)
			check(entry.size.x>=56 and entry.size.y>=56,"navigation has large touch area: "+name)
		await capture("%dx%d-voyage" % [resolution.x,resolution.y])
	app.handle_ui("local_panel","craft"); await settle()
	var grid = app.find_child("RecipeGrid",true,false)
	check(grid.columns<=3,"phone recipe grid reduces density")
	await capture("craft")
	app.handle_ui("craft_tab","transmute"); await settle()
	var columns = app.find_child("TransmuteColumns",true,false)
	check(columns is HBoxContainer,"phone transmutation keeps three side-by-side columns")
	var material_col = app.find_child("TransmuteInventory",true,false)
	var core_col = app.find_child("TransmuteCore",true,false)
	var target_col = app.find_child("TransmuteRightCol",true,false)
	if columns is HBoxContainer and material_col and core_col and target_col:
		check(material_col.position.x<core_col.position.x and core_col.position.x<target_col.position.x,"phone transmutation orders columns left to right")
		check(absf(material_col.position.y-core_col.position.y)<2.0 and absf(core_col.position.y-target_col.position.y)<2.0,"phone transmutation columns share one row")
		check(core_col.size.x<material_col.size.x*1.3,"phone transmutation narrows the middle column")
	await capture("transmute")
	app.local_panel=""; app.render(); await settle()
	app.handle_command("home"); app.handle_command("panel",{"id":"encyclopedia"}); await settle()
	var reference_grid=app.find_child("EncyclopediaGrid",true,false)
	check(reference_grid!=null,"encyclopedia opens through home route")
	if reference_grid: check(reference_grid.columns==2,"phone encyclopedia uses two columns")
	await capture("encyclopedia")
	app.handle_command("close"); app.handle_command("resume"); await settle()
	app.handle_command("panel",{"id":"collectibles"}); await settle()
	check(app.find_child("CollectiblesGrid",true,false).columns==3,"phone collectibles use fewer columns")
	await capture("collectibles")
	app.handle_command("close"); await settle()
	saved=app.session.snapshot()
	var story=load("res://pages/story_page.gd").new(); story.z_index=400; app.add_child(story)
	story.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var demo=JSON.parse_string(FileAccess.get_file_as_string("res://story/demo_story.json"))
	demo.nodes[0].text="用于验证手机长篇剧情的可读性、换行与滚动。".repeat(8).left(160)
	demo.nodes[1].text="下一段剧情应该从开头开始阅读。".repeat(12).left(160)
	check(story.load_story(demo).ok,"phone story loads")
	story.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT); story.size=Vector2(760,360)
	await settle()
	story.advance(); await settle()
	check(story.mobile_layout and story.body.get_theme_font_size("font_size")>=22,"phone narrative has independent readable text")
	check(story.body.get_global_transform().get_scale().is_equal_approx(Vector2.ONE),"phone story copy avoids composition fit scaling")
	var reading=story.find_child("MobileStoryReading",true,false)
	check(reading.get_v_scroll_bar().max_value>reading.get_v_scroll_bar().page,"long phone narrative can scroll")
	reading.scroll_vertical=200; story.advance(); await settle()
	check(reading.scroll_vertical==0,"new story node resets reading to the beginning")
	story.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	story.body.visible_characters=-1; await settle(); await capture("story-long")
	story.skip(); await settle()
	check(story.choice_buttons.size()==2,"phone story still stops at choices")
	await capture("story-choices")
	var before_story: Dictionary=story.player.get_view()
	story.open_log(); await settle(); story.advance()
	check(story.player.get_view()==before_story,"phone log remains read only")
	await capture("story-log")
	story.close_log(); story.queue_free(); await settle()
	check(app.session.snapshot()==saved,"phone narrative preview preserves game session")
	var hud = load("res://presentation/hud/status_hud.gd").new(); app.add_child(hud)
	hud.font_size=24; hud.size=Vector2(1000,56)
	check(hud.stat_layout()[0].font_size==24,"status numbers honor larger configured font")
	hud.free()
	app.display_settings.mobile=false; app.display_settings.ui_scale=1; app.apply_display_settings(false)
	app.handle_ui("local_panel","settings"); await settle()
	check(app.find_child("SettingsBack",true,false)==null,"desktop retains dialog navigation")
	check(app.find_child("ModalSurface",true,false).size.x<=702,"desktop retains compact dialog width")
	check(app.session.snapshot()==saved,"all presentation checks preserve session")
	app.queue_free(); await settle()
	print("MOBILE READABILITY: "+("PASS" if failures==0 else "FAIL (%d)" % failures)); quit(failures)
