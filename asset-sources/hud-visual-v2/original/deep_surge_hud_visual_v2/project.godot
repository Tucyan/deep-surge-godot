config_version=5

[application]
config/name="Deep Surge HUD V2 Visual Match"
run/main_scene="res://demo/demo.tscn"

[display]
window/size/viewport_width=1672
window/size/viewport_height=941
window/stretch/mode="canvas_items"

[editor_plugins]
enabled=PackedStringArray("res://addons/deep_surge_status/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
